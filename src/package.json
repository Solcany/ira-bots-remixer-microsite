{
  "name": "IRAbotWizard",
  "version": "1.0.0",
  "description": "",
  "main": "js/main.js",
  "scripts": {
    "dev": "concurrently --kill-others --names sass,server \"pnpm watch-scss\" \"pnpm serve\"",
    "serve": "browser-sync start --server --files 'index.html, stage.html, css/*.css, js/**/*.js' --index index.html --no-notify",
    "watch-scss": "sass --watch scss/main.scss:css/main.css",
    "build-css": "sass scss/main.scss:css/main.css"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "Matus Solcany",
  "license": "ISC",
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6",
    "sass": "^1.107.0"
  },
  "dependencies": {
    "lodash.debounce": "^4.0.8"
  },
  "packageManager": "pnpm@11.22.0"
}
